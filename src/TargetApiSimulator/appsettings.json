{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff ",
      "UseUtcTimestamp": true
    }
  },
  "AllowedHosts": "*",
  "Simulator": {
    "EnableControlHeaders": false,
    "MaxDelayMs": 60000
  }
}
